# ── Fase 1: Apollo (requerido) ────────────────────────────────────────────
APOLLO_API_KEY=tu_api_key_de_apollo
# DATABASE_URL=postgresql://...   # Neon, modo pooled

# ── Acceso del equipo (requerido para ver o modificar datos) ─────────────
# AUTH_SECRET: firma HMAC de la cookie de sesión. Mínimo 32 caracteres.
#   openssl rand -base64 32
# TEAM_PASSWORD: contraseña compartida del equipo. Mínimo 12 caracteres.
#   openssl rand -base64 24
# No las commitees. Sin estas dos variables la app queda cerrada.
AUTH_SECRET=
TEAM_PASSWORD=

# Token que la app añade a webhook_url de Apollo (?token=). Mínimo 16 caracteres.
#   openssl rand -hex 32
# Sin este valor no se revelan teléfonos y el webhook rechaza cualquier POST.
APOLLO_WEBHOOK_SECRET=
# APOLLO_WEBHOOK_BASE_URL=https://agente-ventas-three.vercel.app

# ── Fase 3: Mistral + WhatsApp ────────────────────────────────────────────
# MISTRAL_API_KEY=tu_api_key_de_mistral
# MISTRAL_AGENT_ID=ag_019ed5b36de7773894387f3ed518b45a
# SALES_EMAIL=tu_correo@empresa.com
# App Secret de Meta (Settings → Basic). Firma X-Hub-Signature-256. Mínimo 16.
WHATSAPP_APP_SECRET=
# Token que tú eliges y pegas también en la configuración del webhook de Meta. Mínimo 8.
WHATSAPP_VERIFY_TOKEN=
