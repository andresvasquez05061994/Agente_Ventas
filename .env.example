# ── Acceso (obligatorio en producción / Vercel) ───────────────────────────
APP_PASSWORD=cambia-esta-clave
AUTH_SECRET=genera-una-cadena-larga-aleatoria

# ── Apollo (requerido) ────────────────────────────────────────────────────
APOLLO_API_KEY=tu_api_key_de_apollo
APOLLO_WEBHOOK_BASE_URL=https://agente-ventas-three.vercel.app
# El tope de la app es 2500 y se reinicia cada mes (UTC).
# Configuración puede cambiarlo solo durante el mes en curso.

# ── Base de datos ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://

# ── Webhooks (opcional; si no se definen se derivan de AUTH_SECRET) ───────
# APOLLO_WEBHOOK_SECRET=
# WHATSAPP_WEBHOOK_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# ── Mistral ───────────────────────────────────────────────────────────────
# MISTRAL_API_KEY=tu_api_key_de_mistral
# MISTRAL_MODEL=mistral-small-latest
